{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run typecheck && npm test -- --run && npm run build",
  "outputDirectory": "dist",
  "rewrites": [{"source": "/((?!assets/|swagger/|openapi.json|api-docs.html).*)", "destination": "/index.html"}],
  "headers": [{"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}]
}
